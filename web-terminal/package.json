{
  "name": "@argon-algo/web-terminal",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Google L8++ Pure Vanilla CSS + Svelte 5 Multi-Monitor Command Terminal",
  "imports": {
    "#lib/*": "./src/lib/*",
    "#styles/*": "./src/styles/*"
  },
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --fail-on-warnings",
    "test": "vitest run --config vitest.config.ts"
  },
  "devDependencies": {
    "@sveltejs/adapter-static": "3.0.10",
    "@sveltejs/kit": "2.57.1",
    "@sveltejs/vite-plugin-svelte": "7.1.2",
    "@types/node": "25.9.1",
    "svelte": "5.55.0",
    "svelte-check": "4.4.8",
    "typescript": "6.0.3",
    "vite": "8.0.14",
    "vitest": "4.1.7"
  }
}
