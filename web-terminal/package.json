{
  "name": "@argon-algo/web-terminal",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Google L8++ Pure Vanilla CSS + Svelte 5.57 Multi-Monitor Command Terminal",
  "imports": {
    "#lib/*": "./src/lib/*",
    "#styles/*": "./src/styles/*"
  },
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --fail-on-warnings",
    "test": "vitest run",
    "test:browser": "vitest run --browser.enabled"
  },
  "dependencies": {
    "d3": "^7.9.0",
    "exceljs": "^4.4.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.52.0",
    "@sveltejs/adapter-auto": "^4.0.0",
    "@sveltejs/kit": "3.0.0",
    "@sveltejs/vite-plugin-svelte": "7.1.0",
    "@types/d3": "^7.4.3",
    "@types/node": "^24.0.0",
    "@vitest/browser": "^5.0.0",
    "lightningcss": "^1.30.0",
    "playwright": "^1.52.0",
    "svelte": "5.57.1",
    "svelte-check": "^4.1.6",
    "typescript": "6.0.2",
    "vite": "8.3.4",
    "vitest": "5.0.0"
  }
}